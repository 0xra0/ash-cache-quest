module AshCache

// Reschedulable ticks. DelayCallback is the only self-driving timer a
// ScriptableSystem gets; the callback holds a weak ref back so a torn-down
// system cannot be resurrected by a timer that outlived it.
public class AshCacheStartCallback extends DelayCallback {
  public let sys: wref<AshCacheGlue>;

  public func Call() -> Void {
    if IsDefined(this.sys) {
      this.sys.FireStart();
    }
  }
}

public class AshCacheWatchCallback extends DelayCallback {
  public let sys: wref<AshCacheGlue>;

  public func Call() -> Void {
    if IsDefined(this.sys) {
      this.sys.OnWatchTick();
    }
  }
}

// Props are drawn by Codeware's DynamicEntitySystem, which is not ready at the
// moment a save finishes loading. This retries the draw instead of leaving the
// bench empty until the next time one of the watched facts happens to change.
public class AshCachePropCallback extends DelayCallback {
  public let sys: wref<AshCacheGlue>;

  public func Call() -> Void {
    if IsDefined(this.sys) {
      this.sys.OnPropRetry();
    }
  }
}

// Fact listeners run on the quest system's job thread, and ToggleNode called
// there deadlocks against the main thread: the engine watchdog kills the game
// two minutes later (2026-09-24, the step to progress 2). The toggle is always
// applied from here instead, the way INCF-CORE toggles its crate.
public class AshCacheHideCallback extends DelayCallback {
  public let sys: wref<AshCacheGlue>;

  public func Call() -> Void {
    if IsDefined(this.sys) {
      this.sys.OnHideApply();
    }
  }
}

