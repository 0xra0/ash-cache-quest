  // Idempotent: OnAttach and OnRestored both land here on a loaded save.
  private func Register() -> Void {
    let gi = this.GetGameInstance();
    let jm = GameInstance.GetJournalManager(gi);
    if IsDefined(jm) && !this.m_journalRegistered {
      jm.RegisterScriptCallback(this, n"OnAshCacheEntryVisited", gameJournalListenerType.Visited);
      this.m_journalRegistered = true;
    }
    let qs = GameInstance.GetQuestsSystem(gi);
    if IsDefined(qs) {
      if !this.m_progressRegistered {
        this.m_progressListener = qs.RegisterListener(n"ashcache_progress", this, n"OnAshCacheProgress");
        this.m_progressRegistered = true;
      }
      if !this.m_prereqRegistered {
        this.m_prereqListener = qs.RegisterListener(n"q304_done", this, n"OnAshCachePrereq");
        this.m_prereqRegistered = true;
      }
      if !this.m_propRegistered {
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_box_opened", this, n"OnAshCachePropFact"));
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_splinter_given", this, n"OnAshCachePropFact"));
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_mara_body_placed", this, n"OnAshCachePropFact"));
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_mara_liberty_given", this, n"OnAshCachePropFact"));
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_mara_trophy_dropped", this, n"OnAshCachePropFact"));
        ArrayPush(this.m_propListener, qs.RegisterListener(n"ashcache_progress", this, n"OnAshCachePropFact"));
        this.m_propRegistered = true;
      }
      if !this.m_rearmRegistered {
        ArrayPush(this.m_rearmListener, qs.RegisterListener(n"ashcache_cyn_escaped", this, n"OnAshCacheAreaRearm"));
        this.m_rearmRegistered = true;
      }
    }
  }

  // Facts live in the save; the listeners and the armed watch do not. Every
  // fact this file sets is recomputed from observable state here, so a load
  // lands where a continuous session would have.
  private func Resync() -> Void {
    this.EvaluateStart();
    this.SyncShards();
    this.SyncProps();
    this.SyncHide_ac_clinic();
    this.ArmWatch(GetFact(this.GetGameInstance(), n"ashcache_progress"));
  }

  // ---- ashcache_start ----

  public final func OnAshCachePrereq(value: Int32) -> Void {
    this.EvaluateStart();
  }

  private func EvaluateStart() -> Void {
    let gi = this.GetGameInstance();
    if this.m_startPending {
      return;
    }
    if GetFact(gi, n"ashcache_start") > 0 {
      return;
    }
    if GetFact(gi, n"q304_done") < 1 {
      return;
    }
    this.m_startPending = true;
    let cb = new AshCacheStartCallback();
    cb.sys = this;
    GameInstance.GetDelaySystem(gi).DelayCallback(cb, 30.00, false);
  }

  // Re-tested rather than trusted: the delay is real seconds and anything
  // can happen inside it, including the player loading an older save.
  public func FireStart() -> Void {
    this.m_startPending = false;
    let gi = this.GetGameInstance();
    if GetFact(gi, n"ashcache_start") > 0 {
      return;
    }
    if GetFact(gi, n"q304_done") < 1 {
      return;
    }
    SetFactValue(gi, n"ashcache_start", 1);
  }

  // ---- shard reads ----

  protected cb func OnAshCacheEntryVisited(
    entryHash: Uint32,
    className: CName,
    notifyOption: JournalNotifyOption,
    changeType: JournalChangeType
  ) -> Bool {
    if !Equals(className, n"gameJournalOnscreen") {
      return false;
    }
    let gi = this.GetGameInstance();
    let jm = GameInstance.GetJournalManager(gi);
    if !IsDefined(jm) {
      return false;
    }
    let i = 0;
    while i < ArraySize(this.m_shardPath) {
      // Hashes are resolved on first use, not at attach: the entry does not
      // exist until the journal has loaded ours.
      if !this.m_shardResolved[i] {
        let entry = jm.GetEntryByString(this.m_shardPath[i], "gameJournalOnscreen");
        if IsDefined(entry) {
          this.m_shardHash[i] = Cast<Uint32>(jm.GetEntryHash(entry));
          this.m_shardResolved[i] = true;
        }
      }
      if this.m_shardResolved[i] && this.m_shardHash[i] == entryHash {
        SetFactValue(gi, this.m_shardFact[i], 1);
        return true;
      }
      i += 1;
    }
    return false;
  }

  private func SyncShards() -> Void {
    let gi = this.GetGameInstance();
    let jm = GameInstance.GetJournalManager(gi);
    if !IsDefined(jm) {
      return;
    }
    let i = 0;
    while i < ArraySize(this.m_shardPath) {
      if GetFact(gi, this.m_shardFact[i]) <= 0 {
        let entry = jm.GetEntryByString(this.m_shardPath[i], "gameJournalOnscreen");
        if IsDefined(entry) && jm.IsEntryVisited(entry) {
          SetFactValue(gi, this.m_shardFact[i], 1);
        }
      }
      i += 1;
    }
  }

  // ---- arrival ----

  public final func OnAshCacheProgress(value: Int32) -> Void {
    this.ArmWatch(value);
  }

  // Every unfired area of the current act is watched, and only during that
  // act. Outside those windows nothing is scheduled at all, which is the
  // difference between a mod that costs nothing when idle and one that polls
  // the player's position for the rest of the playthrough. D185: stage 7 arms
  // two areas (landfill, shaft head); this used to keep only the last match,
  // so the landfill could never fire.
  private func ArmWatch(stage: Int32) -> Void {
    let gi = this.GetGameInstance();
    let found = false;
    let i = 0;
    while i < ArraySize(this.m_areaFact) {
      if this.m_areaStage[i] == stage && GetFact(gi, this.m_areaFact[i]) <= 0 {
        found = true;
      }
      i += 1;
    }
    this.m_watchStage = found ? stage : -1;
    if found && !this.m_watchScheduled {
      this.ScheduleWatch(1.00);
    }
  }

  private func ScheduleWatch(delay: Float) -> Void {
    let cb = new AshCacheWatchCallback();
    cb.sys = this;
    this.m_watchScheduled = true;
    GameInstance.GetDelaySystem(this.GetGameInstance()).DelayCallback(cb, delay, false);
  }

  public func OnWatchTick() -> Void {
    this.m_watchScheduled = false;
    let stage = this.m_watchStage;
    if stage < 0 {
      return;
    }
    let gi = this.GetGameInstance();
    let player = GetPlayer(gi);
    if !IsDefined(player) {
      this.ScheduleWatch(2.00);
      return;
    }
    let p = player.GetWorldPosition();
    let gap = -1.00;
    let i = 0;
    while i < ArraySize(this.m_areaFact) {
      if this.m_areaStage[i] == stage && GetFact(gi, this.m_areaFact[i]) <= 0 {
        let dx = p.X - this.m_areaX[i];
        let dy = p.Y - this.m_areaY[i];
        let dz = p.Z - this.m_areaZ[i];
        let d = SqrtF(dx * dx + dy * dy + dz * dz) - this.m_areaR[i];
        if d <= 0.00 {
          SetFactValue(gi, this.m_areaFact[i], 1);
        } else {
          if gap < 0.00 || d < gap {
            gap = d;
          }
        }
      }
      i += 1;
    }
    if gap < 0.00 {
      this.m_watchStage = -1;
      return;
    }
    // Sample rate follows the approach to the NEAREST open area, so a car
    // cannot jump a sphere: the next sample is timed for how long the gap
    // takes to close at 60 m/s, the rough ceiling for a vehicle here. Far
    // away that is one sample every five seconds; on the doorstep it is
    // four a second.
    this.ScheduleWatch(ClampF(gap / 60.00, 0.25, 5.00));
  }

  // ---- fact-driven props (D118) ----

  // Which look a prop is wearing, recomputed from the facts. Nothing here
  // decides anything: the graph has already decided, and this is the object on
  // the bench catching up with it. Runs on every watched fact, on OnAttach and
  // on OnRestored, because persistSpawn is false - a loaded save has no
  // dynamic entities at all until something draws them again.
  private func SyncProps() -> Void {
    let gi = this.GetGameInstance();
    if !AshCachePropReady() {
      this.SchedulePropRetry();
      return;
    }
    // ac_case: 2 state(s) at world.json ac_splinter_box  (D102)
    // First state whose facts hold is the one drawn.
    if GetFact(gi, n"ashcache_box_opened") >= 1 && GetFact(gi, n"ashcache_splinter_given") <= 0 {
      AshCachePropDespawn(n"ashcache_case_closed");
      AshCachePropSpawn(n"ashcache_case_open", r"mod\\ash_cache\\props\\ash_case\\ash_case_open.ent", -1910.870, -2466.220, 24.898, 45.00, 0.00, n"None");
    } else {
      AshCachePropDespawn(n"ashcache_case_open");
      AshCachePropSpawn(n"ashcache_case_closed", r"mod\\ash_cache\\props\\ash_case\\ash_case_closed.ent", -1910.870, -2466.220, 24.898, 45.00, 0.00, n"None");
    }
    // ac_body: 2 state(s) at world.json ac_mara_body  (Position verified)
    // First state whose facts hold is the one drawn.
