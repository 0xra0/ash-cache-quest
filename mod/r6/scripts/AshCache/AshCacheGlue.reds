  // public, not private: this overrides a public method and redscript
  // refuses to narrow visibility. Getting it wrong costs the whole file.
  public func OnAttach() -> Void {
    this.Prepare();
    this.Register();
    this.Resync();
  }

  public func OnRestored(saveVersion: Int32, gameVersion: Int32) -> Void {
    this.Prepare();
    this.Register();
    this.Resync();
  }

  public func OnDetach() -> Void {
    let gi = this.GetGameInstance();
    let jm = GameInstance.GetJournalManager(gi);
    if IsDefined(jm) && this.m_journalRegistered {
      jm.UnregisterScriptCallback(this, n"OnAshCacheEntryVisited");
      this.m_journalRegistered = false;
    }
    let qs = GameInstance.GetQuestsSystem(gi);
    if IsDefined(qs) {
      if this.m_progressRegistered {
        qs.UnregisterListener(n"ashcache_progress", this.m_progressListener);
        this.m_progressRegistered = false;
      }
      if this.m_prereqRegistered {
        qs.UnregisterListener(n"q304_done", this.m_prereqListener);
        this.m_prereqRegistered = false;
      }
      if this.m_propRegistered {
        qs.UnregisterListener(n"ashcache_box_opened", this.m_propListener[0]);
        qs.UnregisterListener(n"ashcache_splinter_given", this.m_propListener[1]);
        qs.UnregisterListener(n"ashcache_mara_body_placed", this.m_propListener[2]);
        qs.UnregisterListener(n"ashcache_mara_liberty_given", this.m_propListener[3]);
        qs.UnregisterListener(n"ashcache_mara_trophy_dropped", this.m_propListener[4]);
        qs.UnregisterListener(n"ashcache_progress", this.m_propListener[5]);
        ArrayClear(this.m_propListener);
        this.m_propRegistered = false;
      }
      if this.m_rearmRegistered {
        qs.UnregisterListener(n"ashcache_cyn_escaped", this.m_rearmListener[0]);
        ArrayClear(this.m_rearmListener);
        this.m_rearmRegistered = false;
      }
    }
    this.m_watchStage = -1;
  }

