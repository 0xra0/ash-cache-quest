  // D193: an area marked 'rearm' has its fact reset to 0 by the graph when it
  // wants another arrival (the Cynosure return, once per descent). The watch
  // is otherwise re-armed only on a progress change or a load.
  public final func OnAshCacheAreaRearm(value: Int32) -> Void {
    if value <= 0 {
      this.ArmWatch(GetFact(this.GetGameInstance(), n"ashcache_progress"));
    }
  }

  public final func OnAshCachePropFact(value: Int32) -> Void {
    this.SyncProps();
    this.SyncHide_ac_clinic();
  }

  // ---- vanilla furniture hidden while the quest owns a room (D134) ----

  public func OnHideApply() -> Void {
    this.m_hideScheduled = false;
    this.ApplyHide_ac_clinic();
  }

  private func SyncHide_ac_clinic() -> Void {
    if this.m_hideScheduled {
      return;
    }
    let cb = new AshCacheHideCallback();
    cb.sys = this;
    this.m_hideScheduled = true;
    GameInstance.GetDelaySystem(this.GetGameInstance()).DelayCallback(cb, 0.10, false);
  }

  private func ApplyHide_ac_clinic() -> Void {
    let gi = this.GetGameInstance();
    let want = GetFact(gi, n"ashcache_progress") >= 2 && GetFact(gi, n"ashcache_progress") <= 6;
    // Show only what this quest hid; outside the window vanilla owns the room.
    if !want && !this.m_hidden_ac_clinic {
      return;
    }
    if AshCacheHide_ac_clinic(!want) {
      this.m_hidden_ac_clinic = want;
    }
  }

  public func OnPropRetry() -> Void {
    this.m_propRetryScheduled = false;
    this.SyncProps();
  }

  // One retry in flight at a time, and only while the spawn system is not up
  // yet. Once it answers, the facts drive the draw and nothing is scheduled.
  private func SchedulePropRetry() -> Void {
    if this.m_propRetryScheduled {
      return;
    }
    let cb = new AshCachePropCallback();
    cb.sys = this;
    this.m_propRetryScheduled = true;
    GameInstance.GetDelaySystem(this.GetGameInstance()).DelayCallback(cb, 2.00, false);
  }
}

// The drawing itself. Codeware, because the engine has no way to take a placed
// sector node back out of the world - which is why source/world.json carries the
// case as a 'disabled' prop: that entry is the measured pose, not a node.
//
// persistSpawn false, exactly as the echo fragments do it: the save then never
// carries a case in the wrong state, and Resync redraws it from the facts on the
// next load. IsPopulated counts registered entities rather than streamed-in ones,
// so a second call while one is already up is a no-op.
@if(ModuleExists("Codeware"))
public func AshCachePropReady() -> Bool {
  let des = GameInstance.GetDynamicEntitySystem();
  return IsDefined(des) && des.IsReady();
}

// Without Codeware there is nothing to wait for, and returning false here would
// reschedule the retry forever. The props are simply not drawn.
@if(!ModuleExists("Codeware"))
public func AshCachePropReady() -> Bool {
  return true;
}

@if(ModuleExists("Codeware"))
public func AshCachePropSpawn(tag: CName, template: ResRef, x: Float, y: Float,
                              z: Float, yaw: Float, roll: Float, appearance: CName) -> Void {
  let des = GameInstance.GetDynamicEntitySystem();
  if !IsDefined(des) || !des.IsReady() || des.IsPopulated(tag) {
    return;
  }
  let spec = new DynamicEntitySpec();
  spec.templatePath = template;
  // Left unset the entity draws its defaultAppearance. Codeware's own
  // comment on the field says the same, so n"None" means 'do not override'.
  if NotEquals(appearance, n"None") {
    spec.appearanceName = appearance;
  }
  spec.position = Vector4(x, y, z, 1.0);
  let rot: EulerAngles;
  rot.Yaw = yaw;
  // D184: a prop lying on its side. The interactive Liberty's mesh stands on its grip.
  rot.Roll = roll;
  spec.orientation = EulerAngles.ToQuat(rot);
  spec.persistState = false;
  spec.persistSpawn = false;
  spec.alwaysSpawned = false;
  // true, and not for the reason the fragments set it: the player is a metre
  // from the case and looking straight at it when the state changes. Refuse to
  // spawn in view and the case would swap only once they turned away.
  spec.spawnInView = true;
  spec.active = true;
  ArrayPush(spec.tags, tag);
  if !EntityID.IsDefined(des.CreateEntity(spec)) {
    FTLogWarning("ashcache: prop " + NameToString(tag) + " did not spawn");
  }
}

@if(ModuleExists("Codeware"))
public func AshCachePropDespawn(tag: CName) -> Void {
  let des = GameInstance.GetDynamicEntitySystem();
  if IsDefined(des) && des.IsReady() && des.IsPopulated(tag) {
    des.DeleteTagged(tag);
  }
}

@if(!ModuleExists("Codeware"))
public func AshCachePropSpawn(tag: CName, template: ResRef, x: Float, y: Float,
                              z: Float, yaw: Float, roll: Float, appearance: CName) -> Void {}

@if(!ModuleExists("Codeware"))
public func AshCachePropDespawn(tag: CName) -> Void {}

@if(ModuleExists("Codeware"))
public func AshCacheHide_ac_clinic(show: Bool) -> Bool {
  let ws = GameInstance.GetWorldStateSystem();
  if !IsDefined(ws) {
    return false;
  }
  return true;
}

@if(!ModuleExists("Codeware"))
public func AshCacheHide_ac_clinic(show: Bool) -> Bool {
  return false;
}

// Codeware only. Without it nothing is tagged and nothing is hidden: the room
// stays vanilla, which is the safe way to fail.
@if(ModuleExists("Codeware"))
public class AshCacheHideRefs extends ScriptableService {
  private cb func OnLoad() {
    let cbs = GameInstance.GetCallbackSystem();
  }

}

@if(ModuleExists("Codeware"))
public static func AshCacheTagSector(sector: ref<worldStreamingSector>, prefix: String,
                                     setups: Int32, idx: array<Int32>, cls: array<CName>) -> Void {
  if !IsDefined(sector) {
    return;
  }
  if sector.GetNodeSetupCount() != setups {
    FTLogWarning("[AshCache] " + prefix + ": sector has " + ToString(sector.GetNodeSetupCount()) + " setups, scan saw " + ToString(setups) + " - not tagged, the clinic furniture will not hide");
    return;
  }
  let k = 0;
  while k < ArraySize(idx) {
    let node = sector.GetNodeSetup(idx[k]).GetNode();
    if !IsDefined(node) || NotEquals(node.GetClassName(), cls[k]) {
      FTLogWarning("[AshCache] " + prefix + ": setup " + ToString(idx[k]) + " is not a " + NameToString(cls[k]) + " - not tagged");
      return;
    }
    k += 1;
  }
  k = 0;
  while k < ArraySize(idx) {
    let setup = sector.GetNodeSetup(idx[k]);
    // Never overwrite a ref vanilla gave it: Phantom Liberty looks those up.
    if !IsNodeRefDefined(setup.GetNodeRef()) {
      setup.SetNodeRef(CreateNodeRef(prefix + ToString(idx[k])));
    }
    k += 1;
  }
}
